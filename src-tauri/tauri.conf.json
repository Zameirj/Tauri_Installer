{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Caseware Installer",
  "mainBinaryName": "CasewareInstaller",
  "version": "1.0.0",
  "identifier": "com.adaptit.setupinstaller",
  "build": {
    "frontendDist": "../dist/setup-installer/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Caseware Installer",
        "width": 1377,
        "height": 835,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
